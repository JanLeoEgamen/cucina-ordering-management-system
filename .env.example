APP_NAME=Laravel
APP_TIMEZONE=Asia/Manila
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_PERSISTENT=false   # true: reuse the connection between requests (remote database)
# AUTH_CACHE_TTL=300    # seconds the signed-in user + roles may come from the cache; 0 = always the database (several app servers without a shared cache)
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Only when a reverse proxy / CDN (Cloudflare, a load balancer) sits in front of the app: "*" or a
# comma list of its IPs / CIDRs. Then the real client IP and https are read from X-Forwarded-*.
# Leave empty when visitors reach the server directly (a client could forge its IP otherwise).
# TRUSTED_PROXIES=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# The queue the notification jobs go to. A worker must listen to it:
#   php artisan queue:work --queue=notifications,default
NOTIFICATIONS_QUEUE=notifications

# Google Chat direct messages (System Configuration -> Notifications -> "Send notifications to
# Google Chat"). Path to the Chat app's service account key (JSON), e.g. storage/app/private/chat-key.json.
# NEVER commit the key. Setup: Google Cloud project -> enable the Google Chat API -> Configuration
# (app name, "Receive 1:1 messages", visibility) -> create a service account + JSON key. Each person
# must add / open the app once in Google Chat; only people who signed in with Google can be reached.
GOOGLE_CHAT_CREDENTIALS=
# Must match "Markup syntax" in the Chat API configuration: markdown (the default there) or legacy.
GOOGLE_CHAT_MARKUP=markdown
# Shown on the Profile page: the name people search for in Google Chat (empty = the app name from
# System Configuration) and an optional link to the app (e.g. its Marketplace listing).
GOOGLE_CHAT_APP_NAME=Cucina-Feliza
# Example (the project number is the App ID shown in the Marketplace SDK): https://workspace.google.com/marketplace/app/cucina-feliza/335835999129
GOOGLE_CHAT_APP_URL=


# "Continue with Google" (leave blank to hide the button). Create an OAuth client ID of type
# "Web application" in Google Cloud Console and register  APP_URL + /auth/google/callback  as
# an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback


# The audit trail (docs/security.md, "Audit trail"): who did what, kept in `audit_logs`.
# AUDIT_ENABLED=false writes nothing; AUDIT_LOG_VIEWS=true also logs every page opened (off by default: changes and sign in / out are always logged).
# Entries older than AUDIT_RETENTION_DAYS are deleted daily by `audit:prune` (0 keeps everything).
AUDIT_ENABLED=true
AUDIT_LOG_VIEWS=false
AUDIT_RETENTION_DAYS=365

# SERVER_TIMING=false   # true: Server-Timing header (PHP / database time) in DevTools for audit-log readers; see docs/architecture.md


# The first Super Admin, created by `php artisan db:seed` (config/seed.php). Empty email = none
# is created; empty password = a random one is printed once. An account that already exists is
# never changed or promoted. Never commit real values. Keep APP_ENV=production on a server:
# local also creates test@example.com / password as Super Admin.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
# SEED_OWNER_FIRST_NAME=Owner
# SEED_OWNER_LAST_NAME=Account
